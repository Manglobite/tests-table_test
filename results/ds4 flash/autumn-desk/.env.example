# Autumn Desk - runtime configuration.
# Copy to .env and adjust as needed:  cp .env.example .env
#
# The server validates every value before it starts.

# Bind address. 0.0.0.0 exposes the scene to the local network
# (handy for opening it from a phone). Use 127.0.0.1 for this host only.
HOST=0.0.0.0

# TCP port. Must be a free port >= 1024. 8173 is the documented default.
PORT=8173

# Public document root (relative paths are resolved against the project root).
# Only files inside this directory may be served.
PUBLIC_DIR=public
